<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <%- include('../partials/head', { title: t.yt_sync.title }) %>
    <link rel="stylesheet" href="/css/yt-sync/style.css">
    <%- include('../partials/page-scripts', { context: { lang: lang, dict: t, isLoggedIn: locals.isLoggedIn } }) %>
</head>

<body>
    <%- include('../partials/auth-modal') %>
    <main class="page yt-page">
        <%- include('../partials/page-header', { title: t.yt_sync.title, desc: t.yt_sync.desc }) %>

        <% if (!locals.isLoggedIn) { %>
            <section class="card">
                <div class="empty-state">
                    <h2 class="card-title"><%= t.yt_sync.authReq %></h2>
                    <p><%= t.yt_sync.authDesc %></p>
                    <button id="btn-login-prompt" class="btn btn-primary"><%= t.auth.btn_login %></button>
                </div>
            </section>
        <% } else { %>
            <div class="yt-grid">
                <div class="yt-main">
                    <section class="card">
                        <div class="card-header">
                            <h2 class="card-title"><%= t.yt_sync.dlTitle %></h2>
                        </div>
                        <div class="field-row">
                            <div class="field field--grow">
                                <label class="field-label" for="dl-url"><%= t.yt_sync.urlLabel %></label>
                                <input type="text" id="dl-url" class="form-control"
                                    placeholder="<%= t.yt_sync.dlPlaceholder %>" />
                            </div>
                            <button id="btn-download" class="btn btn-primary"><%= t.yt_sync.dlBtn %></button>
                        </div>
                    </section>

                    <section class="card">
                        <div class="card-header">
                            <h2 class="card-title"><%= t.yt_sync.syncTitle %></h2>
                        </div>
                        <div class="field-row">
                            <div class="field field--grow">
                                <label class="field-label" for="sync-url"><%= t.yt_sync.urlLabel %></label>
                                <input type="text" id="sync-url" class="form-control"
                                    placeholder="<%= t.yt_sync.syncPlaceholder %>" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="sync-target"><%= t.yt_sync.targetLabel %></label>
                                <input type="text" id="sync-target" class="form-control"
                                    placeholder="<%= t.yt_sync.targetPlaceholder %>" />
                            </div>
                            <div class="field field--narrow">
                                <label class="field-label" for="sync-interval"><%= t.yt_sync.intervalLabel %></label>
                                <input type="number" id="sync-interval" class="form-control" value="12" min="1" />
                            </div>
                            <button id="btn-sync" class="btn btn-primary"><%= t.yt_sync.syncBtn %></button>
                        </div>
                    </section>

                    <section class="card">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title"><%= t.yt_sync.tasksTitle %></h2>
                                <p class="card-hint"><%= t.yt_sync.forceDesc %></p>
                            </div>
                            <button id="btn-force" class="btn btn-secondary btn-sm"><%= t.yt_sync.forceBtn %></button>
                        </div>
                        <p class="empty-state" id="tasks-loading"><%= t.yt_sync.emptyState %></p>
                        <table class="table d-none" id="tasks-table">
                            <thead>
                                <tr>
                                    <th><%= t.yt_sync.taskUrl %></th>
                                    <th class="is-center yt-col-interval"><%= t.yt_sync.taskInterval %></th>
                                    <th class="is-end yt-col-action"><%= t.yt_sync.taskAction %></th>
                                </tr>
                            </thead>
                            <tbody id="tasks-tbody"></tbody>
                        </table>
                        <p class="empty-state d-none" id="tasks-empty"><%= t.yt_sync.tasksEmpty %></p>
                    </section>
                </div>

                <aside class="card yt-console" id="terminal-panel">
                    <div class="card-header">
                        <h2 class="card-title"><%= t.yt_sync.logsTitle %></h2>
                        <button id="btn-clear-logs" class="btn btn-secondary btn-sm"><%= t.yt_sync.clearBtn %></button>
                    </div>
                    <div class="terminal-viewer" id="log-output">
                        <span class="log-line system"><%= t.yt_sync.consoleTxt %></span>
                    </div>
                </aside>
            </div>
        <% } %>
    </main>

    <script src="/js/yt-sync/script.js" nonce="<%= nonce %>"></script>
</body>

</html>
